{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unseentech.app/schemas/catalog-index/v1.json",
  "title": "CatalogIndex",
  "description": "recipes/index.json in the registry — GENERATED by registry CI (registry-tools index), never hand-edited. See specs/002-recipe-engine/contracts/catalog-index.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipes"],
  "properties": {
    "schema_version": { "const": 1 },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "summary",
          "runtime",
          "mode",
          "verified",
          "play_compatible",
          "sha256"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*__[a-z0-9][a-z0-9._-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "summary": { "type": "string", "maxLength": 140 },
          "category": {
            "type": "string",
            "enum": [
              "pdf",
              "media",
              "privacy",
              "converter",
              "developer",
              "productivity",
              "ai",
              "files",
              "network",
              "other"
            ]
          },
          "runtime": { "type": "string", "enum": ["python", "node", "java", "binary"] },
          "mode": { "type": "string", "enum": ["cli", "webview"] },
          "verified": { "type": "boolean" },
          "play_compatible": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
